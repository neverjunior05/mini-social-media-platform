# PostgreSQL (local docker-compose default). For Neon/Supabase paste their pooled connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public origin used for Open Graph tags and the sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to 1 when running `npx tsx worker/index.ts` as a separate service
# DISABLE_INLINE_WORKER=1

# Optional integrations (features fall back gracefully when unset)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
